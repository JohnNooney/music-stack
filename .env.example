# Copy to .env (git-ignored) and fill in. Read by reorganize_playlists.
JELLYFIN_URL=http://localhost:8096
# Dashboard > API Keys > +. Needed by `migrate --phase playlists`, `import`, `export`, and rollback of those.
JELLYFIN_API_KEY=
# Jellyfin user who owns (and can edit) the playlists.
JELLYFIN_USER=john
# Where the library root is mounted inside the Jellyfin container.
JELLYFIN_MEDIA_ROOT=/media

# --- Music tree (docker-compose interpolation) ---
# Host tree holding Deemix/, Lidarr/ and Jellyfin/ (the union root). Its children are
# bind-mounted into jellyfin (/media, /Deemix, /Lidarr), deemix (/downloads), slskd
# (/deemix) and library-watcher (MUSIC_ROOT). Keep the three as siblings under it —
# union_library writes relative symlinks (../Deemix/…) that must resolve in every
# container and on the host.
MUSIC_DIR=/Volumes/512GB SSD/Music
# Where MUSIC_DIR lands inside library-watcher; the watcher resolves
# Deemix/Lidarr/Jellyfin beneath it. Rarely needs changing.
# MUSIC_ROOT=/music
# Individual watcher roots — only if the sibling layout ever breaks; unset falls
# back to MUSIC_ROOT-derived defaults.
# DEEMIX_ROOT=
# LIDARR_ROOT=
# UNION_ROOT=

# --- Lidarr stack (docker-compose interpolation) ---
# Root folder for all media + download data managed by the Lidarr stack.
DATA_DIR=/path/to/music-lidarr
# User/group the arr containers run as (must match ownership of DATA_DIR).
# macOS: `id -u` / `id -g`. Note jellyfin/deemix/library-watcher run as 502:20 regardless.
PUID=502
PGID=20
TZ=UTC

# slskd secrets — injected by docker-compose as SLSKD_* env vars so nothing
# secret has to live in slskd.yml. SLSKD_API_KEY is the primary API key; it must
# match [Slskd] api_key in soularr/config.ini.
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
SLSKD_USERNAME=
SLSKD_PASSWORD=
SLSKD_API_KEY=
# Optional Transmission web UI auth — uncomment USER/PASS in docker-compose.yml to enable.
# TRANSMISSION_USER=
# TRANSMISSION_PASS=
