{
  "TCP": {
    "443": { "HTTPS": true },
    "8443": { "HTTPS": true },
    "8444": { "HTTPS": true },
    "8445": { "HTTPS": true },
    "8446": { "HTTPS": true },
    "8447": { "HTTPS": true },
    "8448": { "HTTPS": true }
  },
  "Web": {
    "<TS_HOSTNAME>.<tailnet>.ts.net:443": {
      "Handlers": { "/": { "Proxy": "http://jellyfin:8096" } }
    },
    "<TS_HOSTNAME>.<tailnet>.ts.net:8443": {
      "Handlers": { "/": { "Proxy": "http://gluetun:5030" } }
    },
    "<TS_HOSTNAME>.<tailnet>.ts.net:8444": {
      "Handlers": { "/": { "Proxy": "http://gluetun:9091" } }
    },
    "<TS_HOSTNAME>.<tailnet>.ts.net:8445": {
      "Handlers": { "/": { "Proxy": "http://gluetun:9696" } }
    },
    "<TS_HOSTNAME>.<tailnet>.ts.net:8446": {
      "Handlers": { "/": { "Proxy": "http://deemix:6595" } }
    },
    "<TS_HOSTNAME>.<tailnet>.ts.net:8447": {
      "Handlers": { "/": { "Proxy": "http://lidarr:8686" } }
    },
    "<TS_HOSTNAME>.<tailnet>.ts.net:8448": {
      "Handlers": { "/": { "Proxy": "http://soularr:8265" } }
    }
  }
}
